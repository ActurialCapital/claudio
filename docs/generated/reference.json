  ],
  "commands": [
    {
      "usage": "claudio",
      "help": "talk (runs setup the first time)"
    },
    {
      "usage": "claudio --dangerously-skip-permissions",
      "help": "talk, with the brain's permission checks off until you quit"
    },
    {
      "usage": "claudio setup",
      "help": "the wizard again"
    },
    {
      "usage": "claudio doctor",
      "help": "check everything and run one typed turn"
    },
    {
      "usage": "claudio install",
      "help": "add the Claude Code hooks to ~/.claude/settings.json"
    },
    {
      "usage": "claudio uninstall",
      "help": "remove them"
    },
    {
      "usage": "claudio forget",
      "help": "drop the brain's memory of past conversations"
    },
    {
      "usage": "claudio restart",
      "help": "restart the claudio that is running, once its reply is said"
    },
    {
      "usage": "claudio learn <rule>",
      "help": "add a rule the brain keeps across conversations, to learned.md"
    },
    {
      "usage": "claudio unlearn <words>",
      "help": "drop the one learned rule with these words"
    },
    {
      "usage": "claudio choose <surface> <n>[,<n>\u2026] | --other \"<words>\"",
      "help": "answer the question a session shows"
    },
    {
      "usage": "claudio open <link or note>",
      "help": "open a web link, or a .md/.txt note in ~/Desktop or ~/Documents"
    },
    {
      "usage": "claudio set <key> <value>",
      "help": "change one setting"
    },
    {
      "usage": "claudio hook <event>",
      "help": "what the hooks call"
    }
  ],
  "voices": [
